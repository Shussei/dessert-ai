# --- Backend (server/server.js) ---
# Groq API key — required for all AI endpoints
GROQ_API_KEY=your_groq_api_key_here

# LLM model id (defaults to openai/gpt-oss-120b if omitted)
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated origins allowed by CORS on the backend.
# The Vercel frontend origin goes here (e.g. https://savorsense.vercel.app).
# Leave empty to allow all origins in development.
ALLOWED_ORIGINS=

# --- Frontend (Vite) ---
# Firebase web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the backend API. Omit/leave empty to use the Vite dev proxy
# (http://localhost:3000) during development.
VITE_API_URL=